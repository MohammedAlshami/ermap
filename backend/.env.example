PORT=3002
OPENAI_API_KEY=sk-...
GEOCODE_API_KEY=your_geocode_maps_co_api_key
# Base URL of frontend (for search_data and plot_raster tools). e.g. http://localhost:3001
SEARCH_DATA_BASE_URL=http://localhost:3001
# Optional: Mapbox token for satellite imagery (building/tree detection in drawn area).
# Backend reads MAPBOX_ACCESS_TOKEN first, then VITE_MAPBOX_TOKEN. Or send mapbox_access_token in the chat body.
# MAPBOX_ACCESS_TOKEN=pk....
# VITE_MAPBOX_TOKEN=pk....
