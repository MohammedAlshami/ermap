{
  "description": "Maps dataset keys to R2. Load via /api/files/{r2Key}. Includes metadata for structure, access paths, and filter fields.",
  "malaysia": {
    "geojson": {
      "malaysia": {
        "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
        "r2Key": "ermap/uploads/malaysia.geojson",
        "name": "Malaysia (country)",
        "format": "GeoJSON",
        "metadata": {
          "rootType": "FeatureCollection",
          "access": {
            "features": "data.features",
            "count": "data.features.length",
            "firstFeature": "data.features[0]"
          },
          "structure": {
            "type": "FeatureCollection",
            "features": [{
              "type": "Feature",
              "properties": { "name": "string", "iso": "string (e.g. MY)" },
              "geometry": { "type": "MultiPolygon", "coordinates": "number[][][][]" }
            }]
          },
          "filter": {
            "byProperty": "feature.properties.name | feature.properties.iso"
          }
        }
      },
      "education_centers_malaysia": {
        "id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
        "r2Key": "ermap/uploads/Education_Centers_Malaysia.geojson",
        "name": "Education Centers Malaysia",
        "format": "GeoJSON",
        "metadata": {
          "rootType": "FeatureCollection",
          "geometryTypes": ["Point", "Polygon", "MultiPolygon"],
          "description": "Mixed geometry: points (markers) for schools/education centers and polygons for areas. Filter by geometry.type to separate.",
          "access": {
            "features": "data.features",
            "count": "data.features.length",
            "pointsOnly": "data.features.filter(f => f.geometry?.type === 'Point')",
            "polygonsOnly": "data.features.filter(f => ['Polygon','MultiPolygon'].includes(f.geometry?.type))",
            "byAmenity": "data.features.filter(f => f.properties?.amenity === 'school')",
            "byName": "data.features.find(f => f.properties?.name === '...')"
          },
          "structure": {
            "type": "FeatureCollection",
            "features": [{
              "type": "Feature",
              "geometry": "Point | Polygon | MultiPolygon (mixed)",
              "properties": {
                "osm_id": "number",
                "osm_type": "string (e.g. nodes)",
                "capacity": "number | null",
                "isced_level": "string | null",
                "amenity": "string (e.g. school, college, university)",
                "name": "string"
              }
            }]
          },
          "filter": {
            "byGeometry": "feature.geometry.type (Point | Polygon | MultiPolygon)",
            "byAmenity": "feature.properties.amenity",
            "byName": "feature.properties.name",
            "byOsmId": "feature.properties.osm_id",
            "points": "data.features.filter(f => f.geometry?.type === 'Point')",
            "polygons": "data.features.filter(f => f.geometry?.type === 'Polygon' || f.geometry?.type === 'MultiPolygon')"
          }
        }
      },
      "family_mart": {
        "id": "e5f6a7b8-c9d0-4e1f-2a3b-4c5d6e7f8a9b",
        "r2Key": "uploads/family_mart.geojson",
        "name": "Family Mart stores",
        "format": "GeoJSON",
        "metadata": {
          "rootType": "FeatureCollection",
          "access": {
            "features": "data.features",
            "byState": "data.features.filter(f => f.properties.state === 'Kuala Lumpur')",
            "byName": "data.features.find(f => f.properties.name === '...')"
          },
          "structure": {
            "type": "FeatureCollection",
            "features": [{
              "type": "Feature",
              "geometry": { "type": "Point", "coordinates": "[lng, lat]" },
              "properties": {
                "name": "string",
                "address": "string",
                "state": "string",
                "operating_hour": "string",
                "temp_close_date": "array"
              }
            }]
          },
          "filter": {
            "byName": "feature.properties.name",
            "byState": "feature.properties.state",
            "byAddress": "feature.properties.address"
          }
        }
      },
      "malaysia_district": {
        "id": "c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f",
        "name": "Malaysia districts",
        "format": "GeoJSON",
        "metadata": {
          "rootType": "FeatureCollection",
          "access": {
            "features": "data.features",
            "byId": "data.features.find(f => f.id === 'district-slug')",
            "byState": "data.features.filter(f => f.properties.state === 'SGR')"
          },
          "structure": {
            "type": "FeatureCollection",
            "features": [{
              "type": "Feature",
              "id": "string (kebab-case, e.g. kuala-selangor)",
              "properties": { "name": "string", "code_state": "number", "state": "string (e.g. SGR, KDH, JHR)" },
              "geometry": { "type": "MultiPolygon", "coordinates": "number[][][][]" }
            }]
          },
          "filter": {
            "byId": "feature.id",
            "byState": "feature.properties.state",
            "byName": "feature.properties.name",
            "byCodeState": "feature.properties.code_state"
          }
        }
      }
    },
    "statistics": {
      "tourism": {
        "id": "d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f8a",
        "name": "Tourism",
        "format": "JSON",
        "metadata": {
          "rootType": "object",
          "access": {
            "visitorArrivals": "data.visitor_arrivals",
            "totalArrivals": "data.visitor_arrivals.total_arrivals",
            "yearlyBreakdown": "data.visitor_arrivals.arrivals_yearly_breakdown.years",
            "receiptsBreakdown": "data.visitor_arrivals.receipts_yearly_breakdown.years",
            "flightCapacity": "data.visitor_arrivals.weekly_flight_frequency_and_seat_capacity",
            "sabahHotelSupply": "data.visitor_arrivals.sabah_hotel_room_supply",
            "sabahOccupancy": "data.visitor_arrivals.sabah_hotel_occupancy_jan_sep_2025"
          },
          "structure": {
            "visitor_arrivals": {
              "period": "string",
              "total_arrivals": "number",
              "domestic_arrivals": "number",
              "international_arrivals": "number",
              "total_tourism_receipts_rm_billion": "number",
              "growth_rates": { "total_arrivals": "string", "domestic_arrivals": "string", "international_arrivals": "string", "tourism_receipts": "string" },
              "arrivals_yearly_breakdown": { "years": [{ "year": "number", "arrivals_millions": "number" }] },
              "receipts_yearly_breakdown": { "years": [{ "year": "number", "rm_billion": "number" }] },
              "weekly_flight_frequency_and_seat_capacity": { "effective_from": "string", "international": "object", "domestic": "object" },
              "sabah_hotel_room_supply": "object (keys: 5_star, 4_star, ..., grand_total; values: { hotels, rooms })",
              "sabah_hotel_occupancy_jan_sep_2025": "object (keys: overall, 5_star, 4_star, ...; values: number)"
            }
          },
          "filter": {
            "byYear": "arrivals_yearly_breakdown.years.filter(y => y.year === 2024)",
            "byRating": "sabah_hotel_room_supply['5_star']"
          }
        }
      },
      "water_scarcity": {
        "id": "e5f6a7b8-c9d0-4e1f-2a3b-4c5d6e7f8a9b",
        "name": "Water scarcity",
        "format": "JSON",
        "metadata": {
          "rootType": "array",
          "access": {
            "all": "data",
            "byState": "data.find(row => row.state === 'Sabah')",
            "filterByAccess": "data.filter(row => row.water_access_percent >= 99)"
          },
          "structure": {
            "item": { "state": "string", "water_access_percent": "number", "water_scarcity_percent": "number" }
          },
          "filter": {
            "byState": "row.state",
            "byWaterAccess": "row.water_access_percent",
            "byWaterScarcity": "row.water_scarcity_percent"
          }
        }
      },
      "population_density": {
        "id": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8a9b0c",
        "name": "Population density",
        "format": "JSON",
        "metadata": {
          "rootType": "array",
          "access": {
            "all": "data",
            "byState": "data.find(row => row.state === 'Selangor')",
            "sortByDensity": "data.slice().sort((a, b) => b.people_per_km2 - a.people_per_km2)"
          },
          "structure": {
            "item": { "state": "string", "people_per_km2": "number" }
          },
          "filter": {
            "byState": "row.state",
            "byDensity": "row.people_per_km2"
          }
        }
      }
    },
    "hotels": {
      "sabah_hotels": {
        "id": "a7b8c9d0-e1f2-4a3b-4c5d-6e7f8a9b0c1d",
        "name": "Sabah hotels",
        "format": "GeoJSON",
        "metadata": {
          "rootType": "FeatureCollection",
          "access": {
            "features": "data.features",
            "byLocation": "data.features.filter(f => f.properties.location === 'Kota Kinabalu')",
            "byStatus": "data.features.filter(f => f.properties.status === 'operating')",
            "byHotelType": "data.features.filter(f => f.properties.hotel_type === 'existing')"
          },
          "structure": {
            "type": "FeatureCollection",
            "features": [{
              "type": "Feature",
              "geometry": { "type": "Point", "coordinates": "[lng, lat]" },
              "properties": {
                "name": "string | null",
                "location": "string | null",
                "address": "string | null",
                "rooms": "number | null",
                "status": "string (e.g. operating, planned)",
                "hotel_type": "string (e.g. existing, upcoming)",
                "formatted_address": "string",
                "geocoding_source": "string",
                "source_page_range": "string"
              }
            }]
          },
          "filter": {
            "byName": "feature.properties.name",
            "byLocation": "feature.properties.location",
            "byStatus": "feature.properties.status",
            "byHotelType": "feature.properties.hotel_type",
            "byRooms": "feature.properties.rooms"
          }
        }
      }
    },
    "speedmart": {
      "sabah_speedmart": {
        "id": "b8c9d0e1-f2a3-4b4c-5d6e-7f8a9b0c1d2e",
        "name": "Sabah SpeedMart",
        "format": "GeoJSON",
        "metadata": {
          "rootType": "FeatureCollection",
          "access": {
            "features": "data.features",
            "byDistrict": "data.features.filter(f => f.properties.district === 'Kota Kinabalu')",
            "byState": "data.features.filter(f => f.properties.state === 'Sabah')"
          },
          "structure": {
            "type": "FeatureCollection",
            "features": [{
              "type": "Feature",
              "geometry": { "type": "Point", "coordinates": "[lng, lat]" },
              "properties": {
                "name": "string",
                "address": "string",
                "district": "string",
                "state": "string",
                "latitude": "number",
                "longitude": "number"
              }
            }]
          },
          "filter": {
            "byName": "feature.properties.name",
            "byDistrict": "feature.properties.district",
            "byState": "feature.properties.state"
          }
        }
      }
    }
  }
}
